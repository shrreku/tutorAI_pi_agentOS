# Copy this file to .env. Never commit real credentials.

# Core runtime -----------------------------------------------------------------
# Docker Compose maps Postgres to host port 5433.
DATABASE_URL=postgres://studyagent:studyagent@127.0.0.1:5433/studyagent
API_PORT=4000
PUBLIC_API_BASE_URL=http://localhost:4000
# Use http://localhost:8080 with the default docker-compose.yml, or 5173 for host-native Vite/docker-compose.dev.yml.
PUBLIC_WEB_BASE_URL=http://localhost:8080
SESSION_SECRET=studyagent-local-session-secret
DEV_USER_EMAIL=dev@studyagent.local
LOG_LEVEL=info
ENABLE_DEV_TOOLS=true
ENABLE_LIVE_LLM_TESTS=false
DISABLE_AUTH=true

# Hosted identity (WorkOS AuthKit) ---------------------------------------------
# To test hosted auth locally, set DISABLE_AUTH=false and configure the callback
# as http://localhost:4000/auth/callback in the WorkOS staging environment.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:4000/auth/callback
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Product access and hosted-beta policy ----------------------------------------
BETA_CONSENT_VERSION=2026-06-25
TRIAL_TUTOR_BUDGET_CENTS=100
MAX_WORKSPACES_PER_LEARNER=5
MAX_QUEUED_SOURCES_PER_LEARNER=10
MAX_UPLOAD_BYTES=26214400
CREDIT_RESERVATION_TTL_SECONDS=900
PAID_CREDIT_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage and coordination ----------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=studyagent-local
OBJECT_STORAGE_ACCESS_KEY=studyagent
OBJECT_STORAGE_SECRET_KEY=studyagent-local
OBJECT_STORAGE_REGION=us-east-1
# Docker Compose supplies redis://redis:6379. Leave empty for Postgres-backed coordination.
REDIS_URL=
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=studyagent-local

# On-demand ingestion trigger --------------------------------------------------
INGESTION_TRIGGER_MODE=inline
# Reduce these in hosted beta if provider/monthly limits are tight.
INGESTION_TRIGGER_MAX_JOBS=5
INGESTION_TRIGGER_MIN_INTERVAL_SECONDS=0
# Required only when INGESTION_TRIGGER_MODE=external.
INGESTION_TRIGGER_URL=
INGESTION_TRIGGER_TOKEN=

# LLM, parsing, and embeddings -------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# With docker-compose.yml, run `pnpm dev:openrouter-proxy` on the host.
OPENROUTER_HOST_PROXY_PORT=8787
DOCKER_OPENROUTER_BASE_URL=http://host.docker.internal:8787/api/v1
DOCKER_EMBEDDING_API_BASE_URL=http://host.docker.internal:8787/api/v1
DEFAULT_TUTOR_MODEL=openrouter/auto
DEFAULT_EXTRACTION_MODEL=openrouter/auto
LLM_REQUEST_TIMEOUT_MS=120000
TUTOR_MAX_TOOL_CALLS=16
TUTOR_REHYDRATE_TURN_LIMIT=5
GEMINI_API_KEY=
EMBEDDING_API_BASE_URL=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
LLAMAPARSE_API_KEY=
LLAMAPARSE_API_BASE_URL=https://api.cloud.llamaindex.ai
LLAMAPARSE_TIER=cost_effective

# First-party metrics -----------------------------------------------------------
# No API key is required. Scrape the API's Prometheus endpoint at:
# http://localhost:4000/metrics

# Langfuse LLM tracing and prompt management -----------------------------------
# Optional: tracing is a no-op and prompts use the code fallback when unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local
LANGFUSE_FLUSH_AT=1
LANGFUSE_FLUSH_INTERVAL=1000
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
LANGFUSE_PROMPT_FETCH_TIMEOUT_MS=3000
LANGFUSE_TUTOR_PROMPT_NAME=studyagent-tutor-system

# PostHog product analytics mirror and session replay --------------------------
# POSTHOG_API_KEY is the server-side mirror project token.
# VITE_POSTHOG_API_KEY is embedded into the browser bundle for replay; it is
# normally the same PostHog project token. Production static builds must receive
# all VITE_* values at build time. Enable replay only after masking QA.
# PostHog project API key for /capture/, usually phc_*. Do not use a personal
# API key or project secret here; /capture/ will return 401.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_REPLAY_ENABLED=false
POSTHOG_REPLAY_SAMPLE_RATE=1
# ISO-8601 timestamp with offset; while in the future, replay is disabled.
# Leave empty or set 0 to keep replay governed only by POSTHOG_REPLAY_ENABLED.
POSTHOG_REPLAY_DISABLED_UNTIL=
# Browser project API key for posthog-js replay, usually the same public phc_*.
# If this key/host pair is wrong, posthog-js remote config requests return 404.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring -------------------------------------------------------
# Use a Node/server DSN for API+worker and a browser DSN for the web app.
# DSNs are URL-shaped, e.g. https://PUBLIC_KEY@oORG.ingest.sentry.io/PROJECT_ID.
# Do not put a Sentry auth token (sntryu_*) in these variables.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=local
