# Docker Compose maps Postgres to host port 5433 (see repository root docker-compose.yml).
DATABASE_URL=postgres://studyagent:studyagent@127.0.0.1:5433/studyagent
API_PORT=4000
DEV_USER_EMAIL=dev@studyagent.local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=studyagent-local
OBJECT_STORAGE_ACCESS_KEY=studyagent
OBJECT_STORAGE_SECRET_KEY=studyagent-local
OBJECT_STORAGE_REGION=us-east-1
# Optional for host-native runs. Docker Compose sets redis://redis:6379 on api/worker.
# Leave empty locally to use the default Postgres-backed coordination path.
REDIS_URL=
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=studyagent-local
# Optional; worker projects concepts after LLM enrichment when Neo4j is reachable
OPENROUTER_API_KEY=
# Host-native API: use OpenRouter directly. Docker Compose defaults to the host proxy below.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# When using docker compose, run `pnpm dev:openrouter-proxy` on the host (listens on 127.0.0.1:8787).
OPENROUTER_HOST_PROXY_PORT=8787
# Optional overrides for container routing only (see docker-compose.yml).
# DOCKER_OPENROUTER_BASE_URL=http://host.docker.internal:8787/api/v1
# DOCKER_EMBEDDING_API_BASE_URL=http://host.docker.internal:8787/api/v1
# Optional Langfuse Cloud/self-hosted observability and prompt management.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_FLUSH_AT=
LANGFUSE_FLUSH_INTERVAL=
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
LANGFUSE_PROMPT_FETCH_TIMEOUT_MS=3000
LANGFUSE_TUTOR_PROMPT_NAME=studyagent-tutor-system
# Optional; defaults to OPENROUTER_BASE_URL. OpenAI-compatible POST {base}/embeddings
EMBEDDING_API_BASE_URL=
DEFAULT_TUTOR_MODEL=openrouter/auto
LLM_REQUEST_TIMEOUT_MS=120000
TUTOR_MAX_TOOL_CALLS=16
DEFAULT_EXTRACTION_MODEL=openrouter/auto
GEMINI_API_KEY=
# Short name `gemini-embedding-2` maps to `google/gemini-embedding-2` on OpenRouter
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
LLAMAPARSE_API_KEY=
LLAMAPARSE_API_BASE_URL=https://api.cloud.llamaindex.ai
LLAMAPARSE_TIER=cost_effective
SESSION_SECRET=studyagent-local-session-secret
PUBLIC_API_BASE_URL=http://localhost:4000
LOG_LEVEL=info
ENABLE_DEV_TOOLS=true
ENABLE_LIVE_LLM_TESTS=false
DISABLE_AUTH=true
