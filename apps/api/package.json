{
  "name": "@studyagent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "pnpm --filter @studyagent/graph run build && tsx watch src/index.ts",
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "langfuse:sync-prompts": "tsx src/scripts/sync-langfuse-prompts.ts",
    "cache:cleanup-stale-host-context": "tsx src/scripts/cleanup-stale-agentic-cache.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@studyagent/agent-runtime": "workspace:*",
    "@studyagent/config": "workspace:*",
    "@studyagent/db": "workspace:*",
    "@studyagent/graph": "workspace:*",
    "@studyagent/observability": "workspace:*",
    "@studyagent/schemas": "workspace:*",
    "@studyagent/search": "workspace:*",
    "@studyagent/tools": "workspace:^",
    "@studyagent/wiki-core": "workspace:*",
    "bullmq": "^5.41.2",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@studyagent/eval-runner": "workspace:*",
    "tsx": "latest"
  }
}
