    "@studyagent/observability": "workspace:*",
    "@studyagent/schemas": "workspace:*",
    "@studyagent/wiki-core": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "zod": "latest"
  },
  "devDependencies": {
    "vitest": "latest"
  }
}
