# Dev image with pnpm pre-installed so compose services do not need registry
# access on every container start (corepack prepare is flaky in Docker Desktop).
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

WORKDIR /workspace
