              "height": "fill_container",
              "layout": "vertical",
              "gap": 20,
              "children": [
                {
                  "type": "text",
                  "id": "ofJXb",
                  "name": "Left Page Title",
                  "fill": "#3d705c",
                  "content": "SN2 Reaction Overview",
                  "fontFamily": "Fraunces",
                  "fontSize": 22,
                  "fontWeight": "bold"
                },
                {
                  "type": "text",
                  "id": "DByvK",
                  "name": "Left Page Text",
                  "fill": "#2d2a26",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The bimolecular nucleophilic substitution (SN2) reaction occurs in a single concerted step. The nucleophile attacks the electrophilic carbon center from the opposite side of the leaving group. This backside attack forces the three remaining carbon substituents to flip, like an umbrella in the wind, resulting in stereochemical inversion.",
                  "lineHeight": 1.5,
                  "fontFamily": "Lora",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
