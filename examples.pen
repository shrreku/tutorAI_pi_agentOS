                  "fontFamily": "Fraunces",
                  "fontSize": 32,
                  "fontWeight": "bold"
                },
                {
                  "type": "text",
                  "id": "h8Ovo",
                  "name": "Subtitle",
                  "fill": "#2d2a26",
                  "content": "A high-fidelity layout of an elegant minimalist web application study workspace.",
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "X24nAZ",
                  "name": "Heading 1",
                  "fill": "#3d705c",
                  "content": "Understanding the SN2 Mechanism",
                  "fontFamily": "Fraunces",
                  "fontSize": 20,
                  "fontWeight": "bold"
                },
                {
                  "type": "text",
                  "id": "I7YeyA",
                  "name": "Paragraph 1",
                  "fill": "#2d2a26",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The chemical reaction is a key electrophilic substitution reaction. The nucleophile attacks the carbon atom, displacing the leaving group (Br), opposite to the leaving group. This backside attack results in a Walden inversion of stereochemical configuration.",
                  "lineHeight": 1.5,
                  "fontFamily": "Lora",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "k1E47",
                  "name": "Equation Block",
                  "width": "fill_container",
                  "fill": "#e8f1ec",
                  "cornerRadius": 4,
                  "layout": "vertical",
                  "padding": 16,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "KeucP",
                      "name": "Equation",
                      "fill": "#3d705c",
                      "content": "CH3Br + OH-  --->  CH3OH + Br-",
                      "fontFamily": "Lora",
                      "fontSize": 16,
                      "fontWeight": "bold",
                      "fontStyle": "italic"
                    }
                  ]
                }
              ]
            },
