                    {
                      "type": "text",
                      "id": "izhnL",
                      "name": "Equation",
                      "fill": "#3d705c",
                      "content": "CH3Br + OH-  --->  CH3OH + Br-",
                      "fontFamily": "Lora",
                      "fontSize": 16,
                      "fontWeight": "bold",
                      "fontStyle": "italic"
                    }
                  ]
                }
              ]
            },
