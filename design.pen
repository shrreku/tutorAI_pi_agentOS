                  "name": "Topic - Solvent Effects",
                  "fill": "#2d2a26",
                  "content": "Solvent Effects",
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "R1l0Q",
                  "name": "Topic - Substrate Effects",
                  "fill": "#2d2a26",
                  "content": "Substrate Effects",
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "utMrp",
              "name": "Wiki Content",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#fbf9f4",
              "layout": "vertical",
              "gap": 20,
              "padding": [
                40,
                120
              ],
              "children": [
                {
                  "type": "text",
                  "id": "d4oMD",
                  "name": "Wiki Title",
                  "fill": "#3d705c",
                  "content": "SN2 Reaction Mechanism",
                  "fontFamily": "Fraunces",
                  "fontSize": 28,
                  "fontWeight": "bold"
                },
                {
                  "type": "text",
                  "id": "ELjUr",
                  "name": "Wiki Subtitle",
                  "fill": "#2d2a26",
                  "content": "BIMOLECULAR NUCLEOPHILIC SUBSTITUTION",
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 12,
                  "fontWeight": "normal",
                  "letterSpacing": 1.5
                },
                {
                  "type": "rectangle",
                  "id": "hLUdy",
                  "name": "Divider",
                  "fill": "#e6e2da",
                  "width": "fill_container",
                  "height": 1
                },
                {
                  "type": "text",
                  "id": "QrANe",
                  "name": "Paragraph 1",
                  "fill": "#2d2a26",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The SN2 reaction (substitution nucleophilic bimolecular) is a classic organic chemistry transformation. It proceeds via a single-step concerted mechanism where the nucleophile attacks the substrate from the back side, opposite to the leaving group. This backside attack results in a complete inversion of configuration at the stereocenter carbon (known as Walden inversion).",
                  "lineHeight": 1.5,
                  "fontFamily": "Lora",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "I6ckX",
                  "name": "Formula Block",
                  "width": "fill_container",
                  "fill": "#e8f1ec",
                  "cornerRadius": 4,
                  "layout": "vertical",
                  "padding": 16,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "HAm3t",
                      "name": "Formula Text",
                      "fill": "#3d705c",
                      "content": "Rate = k [Substrate] [Nucleophile]",
                      "fontFamily": "Lora",
                      "fontSize": 16,
                      "fontWeight": "bold",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "Rs3Lf",
                  "name": "Paragraph 2",
                  "fill": "#2d2a26",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Key reaction coordinates involve a transition state with five-coordinate carbon. Because both reactants are involved in the rate-determining step, the kinetics are second-order. The reaction is highly sensitive to steric hindrance; primary halides react much faster than tertiary ones.",
                  "lineHeight": 1.5,
                  "fontFamily": "Lora",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
