                          "name": "titleText",
                          "fill": "$primary-dark",
                          "content": "Core Concept Definition",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "bold"
                        },
                        {
                          "type": "text",
                          "id": "KRusd",
                          "name": "bodyText",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": 920,
                          "content": "The SN2 reaction (Substitution Nucleophilic Bimolecular) is a type of organic reaction mechanism where a bond is broken and another bond is formed synchronously. It is a concerted process that takes place in a single step with a transition state showing partial bonds.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "NWTXL",
                      "name": "factorsGroup",
                      "layout": "vertical",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "a5Jkb",
                          "name": "heading",
                          "fill": "$text-primary",
                          "content": "Key Steric & Kinetic Factors",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "bold"
                        },
                        {
                          "type": "frame",
                          "id": "Z1QR3I",
                          "name": "list",
                          "layout": "vertical",
                          "gap": 8,
                          "children": [
                            {
                              "type": "text",
                              "id": "V7sY3o",
                              "name": "factor1",
                              "fill": "$text-secondary",
                              "content": "\u2022 Substrate structure: Strongly favors methyl and primary halides due to low steric hindrance during transition state.",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "vXhpq",
                              "name": "factor2",
                              "fill": "$text-secondary",
                              "content": "\u2022 Nucleophile strength: Bimolecular rate depends on both substrate and nucleophile concentration; requires a strong nucleophile.",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "UC2MO",
                              "name": "factor3",
                              "fill": "$text-secondary",
                              "content": "\u2022 Leaving group: Facilitated by weak bases / highly stable anions that stabilize the negative charge after separation.",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
