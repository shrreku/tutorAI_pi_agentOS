                      "name": "Rate Formula",
                      "fill": "#2563eb",
                      "content": "Rate = k [Substrate] [Nucleophile]",
                      "fontFamily": "Lora",
                      "fontSize": 15,
                      "fontWeight": "bold",
                      "fontStyle": "italic"
                    }
                  ]
                }
              ]
