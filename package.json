{
  "name": "studyagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @studyagent/web build",
    "check": "tsc -b tsconfig.build.json --pretty false && pnpm --filter @studyagent/web check",
    "check:web": "pnpm --filter @studyagent/web check",
    "test": "vitest run",
    "e2e:hosted-beta": "playwright test -c playwright.hosted-beta.config.ts",
    "test:postgres": "RUN_POSTGRES_INTEGRATION=1 pnpm --filter @studyagent/wiki-generation test:postgres && RUN_POSTGRES_INTEGRATION=1 pnpm --filter @studyagent/db exec vitest run src/generation-jobs.test.ts",
    "format": "prettier --check .",
    "db:generate": "pnpm --filter @studyagent/db generate",
    "db:migrate": "pnpm --filter @studyagent/db migrate",
    "db:seed": "pnpm --filter @studyagent/db seed",
    "dev:openrouter-proxy": "node scripts/openrouter-host-proxy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@rolldown/binding-darwin-arm64": "1.0.0-rc.18",
    "@types/node": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
